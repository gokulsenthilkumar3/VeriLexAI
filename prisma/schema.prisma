generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}



model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  pan           String?   @unique
  aadhaar       String?   @unique
  role          String    @default("TAXPAYER")
  workspace     String    @default("AUDIT") // AUDIT or LEGAL; keeps client rosters separate
  nationality   String?
  residenceCountry String?
  caId          String?   // assigned CA
  ca            User?     @relation("CATaxpayers", fields: [caId], references: [id])
  clients       User[]    @relation("CATaxpayers")
  accounts      BankAccount[]
  portfolios    Portfolio[]
  documents     Document[]
  taxReturns    TaxReturn[]
  auditEngagements AuditEngagement[]
  legalMatters  LegalMatter[]
  wealthScenarios WealthScenario[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AuditEngagement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  financialYear String
  status      String   @default("PLANNING") // PLANNING, FIELDWORK, REVIEW, COMPLETE
  riskLevel   String   @default("MEDIUM")  // LOW, MEDIUM, HIGH
  owner       String?
  region      String   @default("INDIA") // INDIA, US, EU, or other configured region
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LegalMatter {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  reference    String   @unique
  title        String
  practiceArea String
  legalDomain  String   @default("CIVIL")
  region       String   @default("INDIA")
  status       String   @default("INTAKE") // INTAKE, RESEARCH, COUNSEL_REVIEW, CLOSED
  jurisdiction String?
  owner        String?
  nextReviewAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WealthScenario {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  region      String   @default("INDIA")
  currency    String   @default("INR")
  status      String   @default("ACTIVE")
  owner       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BankAccount {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  accountType   String
  bankName      String
  accountNumber String
  ifsc          String?
  balance       Float       @default(0)
  currency      String      @default("INR")
  isLinked      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Portfolio {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  assetType     String
  name          String
  symbol        String?
  quantity      Float
  avgBuyPrice   Float
  currentPrice  Float?
  purchaseDate  DateTime?
  maturityDate  DateTime?
  interestRate  Float?    // for FD/RD/Bond
  platform      String?   // Zerodha, Groww, etc.
  metadata      String?   // extra data like ISIN, exchange
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Document {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  fileName      String
  fileType      String          // pdf, xlsx, docx, jpg, png, etc.
  fileUrl       String
  status        String          @default("PENDING")
  extractedData String?         // AI parsed output
  summary       String?         // AI summary
  taxYear       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model TaxReturn {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  taxYear         String    // e.g., "2025-26"
  regime          String    @default("NEW")  // OLD or NEW
  grossIncome     Float     @default(0)
  totalDeductions Float     @default(0)
  taxableIncome   Float     @default(0)
  taxPayable      Float     @default(0)
  tdsDeducted     Float     @default(0)
  advanceTaxPaid  Float     @default(0)
  refundDue       Float     @default(0)
  status          String    @default("DRAFT") // DRAFT, FILED, REVISED
  itrType         String?   // ITR-1, ITR-2, etc.
  filedOn         DateTime?
  metadata        String?   // deduction details, capital gains breakdown
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
